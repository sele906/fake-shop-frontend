<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        targetSdk 35부터 엣지투엣지가 강제라 android:statusBarColor는 무시된다.
        상태바는 투명해지고 그 뒤로 창 배경(windowBackground)이 비친다 —
        실제로 보이는 색은 이쪽이다. statusBarColor는 안드로이드 14 이하에서만
        의미가 있어 남겨 둔다.

        어느 값을 쓸지는 리소스 설정이 정하는데, ThemePlugin이
        AppCompatDelegate.setDefaultNightMode로 그 설정을 바꾼다. 그래서
        values-night는 시스템 다크가 아니라 앱이 고른 테마를 따른다.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/appBg</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/appBg</item>
        <item name="android:windowLightStatusBar">@bool/statusBarLight</item>
    </style>


    <!--
        앱을 켤 때 로고 화면. MainActivity의 installSplashScreen이 이 테마를 읽고,
        웹이 뜨면 postSplashScreenTheme로 넘어간다.

        예전 android:background의 drawable/splash는 뺐다. 이 속성은 창이 아니라
        모든 뷰의 배경에 걸려서, 안드로이드 11 이하에서는 호환 라이브러리가 그리는
        로고 위에 옛 이미지가 한 벌 더 깔린다.

        바탕은 values-night에서 어두운 값으로 갈린다. 다만 스플래시는 앱 코드가
        돌기 전에 시스템이 그리므로 앱 토글이 아니라 OS 다크 설정을 따른다.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/appBg</item>
        <item name="android:windowLightStatusBar">@bool/statusBarLight</item>
    </style>
</resources>
